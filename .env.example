# =============================================================================
#  Dynamic Multi-Strategy Binance USDⓈ-M Futures Engine — environment template
#  Copy to .env and fill in.  NEVER commit .env.
# =============================================================================

# --- Mode ---------------------------------------------------------------
# BACKTEST | PAPER | LIVE
TRADING_MODE=PAPER

# LIVE mode additionally requires ALL of:
#   TRADING_MODE=LIVE
#   I_UNDERSTAND_LIVE_TRADING_RISK=YES
#   the --live flag on the command line
# Any disagreement between them aborts startup.
I_UNDERSTAND_LIVE_TRADING_RISK=NO

# --- Binance ------------------------------------------------------------
# API key must have FUTURES TRADING enabled and WITHDRAWALS DISABLED.
# Restrict it to your VPS IP address.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Use the Binance futures testnet (https://testnet.binancefuture.com).
# Keep this true until every gate in IMPLEMENTATION_PLAN.md §9 has passed.
BINANCE_TESTNET=true

# Optional overrides (leave blank to use the defaults for the chosen network)
BINANCE_REST_URL=
BINANCE_WS_URL=

# Signature receive window in milliseconds (Binance max 60000)
BINANCE_RECV_WINDOW=5000

# --- Config file --------------------------------------------------------
# Tunable parameters (risk limits, thresholds, strategy params) live here.
CONFIG_FILE=config/config.yaml

# --- Database -----------------------------------------------------------
# SQLite default; for Postgres use postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///data/tradebot.db

# --- Telegram (optional but strongly recommended) -----------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# --- Dashboard ----------------------------------------------------------
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Set a long random string. If empty, the dashboard binds to localhost only.
DASHBOARD_TOKEN=

# --- Logging ------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
LOG_FILE=logs/tradebot.log
